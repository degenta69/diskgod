# Copy to .env. Do not commit .env.

# HTTP port. index.js uses 6453 when this is unset.
PORT=6453

# MongoDB connection string, including the database name.
MONGO_URI=mongodb://127.0.0.1:27017/diskgod

# Secret used to sign login tokens (7 day expiry). Use a long random value.
JWT_SECRET=

# development serves ../diskgod-front/public
# production serves ../diskgod-front/build
NODE_ENV=development
